# TasteMatch AI Configuration Template

# Active LLM Provider Configuration
# Supported options: openai | claude | ollama | gemini
LLM_PROVIDER="openai"

# Optional: Explicit model name override
# If blank, sensible defaults per provider will be used:
# openai -> gpt-4o-mini
# claude -> claude-3-5-sonnet-20241022
# ollama -> llama3.2
# gemini -> gemini-1.5-flash
LLM_MODEL=""

# Enable automatic fallback to next configured provider if primary provider fails
LLM_ENABLE_FALLBACK=true

# Provider Credentials
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."

# Local Provider Endpoint (Ollama)
LOCAL_LLM_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Spotify API Credentials (Required for upcoming milestones)
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIFY_REDIRECT_URI="http://localhost:3000/auth/callback"
